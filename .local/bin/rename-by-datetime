#!/usr/bin/env python

import argparse
import datetime
import os

from PIL import Image
#from PIL.ExifTags import TAGS
from exiftool import ExifToolHelper


def get_datetime_pillow(path):
    img = Image.open(path)
    exif = img._getexif()  # less tags with img.getexif()
    # List of tags:
    # https://www.awaresystems.be/imaging/tiff/tifftags/privateifd/exif.html
    if exif is None:
        return None
    try:
        # DateTimeOriginal: when the original image data was generated
        dt = exif[36867]
    except KeyError:
        # DateTimeDigitized: when the image was stored as digital data
        dt = exif[36868]
    return dt.replace(':', '').replace(' ', '_')

TAGS = [
    "EXIF:DateTimeOriginal",  # when the original image data was generated
    "EXIF:CreateDate",  # DateTimeDigitized: when the image was stored as digital data
    'XMP:CreateDate',  # XMP namespace tag
    'XMP:DateCreated',  # Adobe Photoshop namespace tag
    "QuickTime:CreationDate",
    "QuickTime:CreateDate",
    "Keys:CreationDate",
    "File:FileModifyDate",  # backup
]

TAGS_ALL = [
    "EXIF:DateTimeOriginal",  # when the original image data was generated
    "EXIF:CreateDate",  # DateTimeDigitized: when the image was stored as digital data
    'XMP:CreateDate',  # XMP namespace tag
    'XMP:DateCreated',  # Adobe Photoshop namespace tag
    'QuickTime:CreationDate',
    'QuickTime:CreateDate',
    'QuickTime:ModifyDate',
    'QuickTime:MediaCreateDate',
    'QuickTime:MediaModifyDate',
    'QuickTime:TrackCreateDate',
    'QuickTime:TrackModifyDate',
    'IPTC:DateCreated',
    'IPTC:TimeCreated',
    'EXIF:SubSecTime',
    'EXIF:SubSecTimeOriginal',
    'EXIF:SubSecTimeDigitized',
    'EXIF:OffsetTime',
    'EXIF:OffsetTimeOriginal',
    'EXIF:OffsetTimeDigitized'
    'EXIF:ModifyDate',
    'EXIF:GPSDateStamp',
    'EXIF:GPSTimeStamp',
    'Composite:GPSDateTime',
    'Composite:SubSecDateTimeOriginal',
    'Composite:SubSecCreateDate'
    'Composite:DateTimeCreated',
    'File:FileModifyDate',
    'File:FileInodeChangeDate',
]


def get_datetime_exiftool(path):

    with ExifToolHelper() as et:
        # get all metadata to check existing tags
        #metadata = et.get_metadata(path)
        #print(metadata)

        metadata = et.get_tags(path, tags=TAGS)
        #metadata = et.get_tags(path, tags=TAGS_ALL)
        assert len(metadata) == 1
        metadata = metadata[0]
        #print("\n".join(f"  {v}: {k}" for k, v in metadata.items()))

    for tag in TAGS:
        try:
            dt = metadata[tag]

            # The standard EXIF date/time format is "YYYY:mm:dd HH:MM:SS",
            # and some meta information formats such as XMP also allow sub-seconds
            # and a timezone to be specified. [https://exiftool.org/faq.html]
            return dt[:19].replace(':', '').replace(' ', '_')
            # TODO use datetime, parse timezone etc. → not really needed if I want local time
            # dt = datetime.datetime.fromisoformat(dt)

        except KeyError:
            pass

    return None


def add_offset(dt, offset=0):
    hour = int(dt[9:11]) + offset
    day = int(dt[6:8]) + hour // 24
    hour = hour % 24
    return dt[:6] + f"{day:02d}_{hour:02d}" + dt[11:]


if __name__ == '__main__':

    parser = argparse.ArgumentParser(description='Rename photographs.')
    parser.add_argument('path', metavar='path', type=str,
                        help='path to photographs')
    parser.add_argument("--offset", type=int, default=0,
                        help='Add offset to hour for timezone adjustments (default: 0)')
    parser.add_argument('--dryrun', action='store_true',
                        help="simulate execution but don't rename files")
    parser.set_defaults(dryrun=False)
    args = parser.parse_args()

    for dirpath, _, filenames in os.walk(args.path):
        datetimes = dict()
        for filename in filenames:

            _, ext = os.path.splitext(filename)
            ext = ext.lower().replace("jpeg", "jpg")
            if ext not in [".jpg", ".heic", ".png", ".mp4", ".mov"]:
                continue

            filepath_old = os.path.join(dirpath, filename)

            #dt = get_datetime_pillow(filepath_old)
            dt = get_datetime_exiftool(filepath_old)
            if dt is None:
                print(f'{filepath_old}: no datetime information found')
                continue

            dt = add_offset(dt, args.offset)

            # Last digit is a counter. For files with same datetime.
            if dt not in datetimes.keys():
                datetimes[dt] = 0
            else:
                datetimes[dt] += 1
            dt += '_' + str(datetimes[dt])

            filepath_new = os.path.join(dirpath, dt + ext)

            print(f'{filepath_new} ← {filepath_old}')
            if not args.dryrun:
                os.rename(filepath_old, filepath_new)
